# SPDX-License-Identifier: MIT
#
# Lily58 USB dongle: the receiver is the split central and both keyboard
# halves connect to it as peripherals.

if SHIELD_LILY58_DONGLE

config ZMK_KEYBOARD_NAME
    default "Lily58 Dongle"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Both halves are peripherals.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 5 host profiles + 2 keyboard halves.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # SHIELD_LILY58_DONGLE
